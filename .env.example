# Copie para .env ao rodar `npm run dev` (Netlify Dev lê esse arquivo).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
AUTH_SECRET=troque-por-um-segredo-longo

# Forma simples (recomendado no Netlify):
COORDINATOR_EMAIL=coordenacao@exemplo.com
COORDINATOR_PASSWORD=senha-forte

# Ou JSON com várias contas:
# COORDINATORS=[{"email":"coordenacao@exemplo.com","password":"senha-forte"}]
